// ── Collection: user_engagements ──
// One document per user. Everything about their ad interactions is embedded.
{
  // ─── User Demographics ───
  "_id": 12345,                          // = user_id from MySQL (we reuse it as _id)
  "age": 28,
  "gender": "Male",
  "country": "Germany",                  // Denormalized: country NAME, not ID
  "signup_date": ISODate("2024-01-15"),
  "interests": ["Technology", "Gaming", "Sports"],  // Array, not a bridge table

  // ─── Ad Interaction History ───
  "impressions": [                       // Array of ALL impressions for this user
    {
      "impression_id": "abc-123-def",    // From impressions table
      "campaign_id": 7,
      "campaign_name": "Summer Sale",    // Denormalized from campaigns table
      "advertiser_name": "Nike",         // Denormalized from advertisers table
      "ad_slot_size": "300x250",
      "device": "mobile",
      "country_served": "Germany",       // Where the ad was shown
      "timestamp": ISODate("2024-06-15T14:30:00"),
      "bid_amount": 1.50,
      "ad_cost": 0.85,

      // ─── Nested Clicks (only if this impression was clicked) ───
      "clicks": [                        // Empty array [] if not clicked
        {
          "click_id": "abc-123-def-click",
          "click_timestamp": ISODate("2024-06-15T14:30:45"),
          "ad_revenue": 2.10
        }
      ]
    },
    {
      "impression_id": "xyz-789-ghi",
      "campaign_id": 7,
      "campaign_name": "Summer Sale",
      "advertiser_name": "Nike",
      "ad_slot_size": "728x90",
      "device": "desktop",
      "country_served": "Germany",
      "timestamp": ISODate("2024-06-16T09:15:00"),
      "bid_amount": 2.00,
      "ad_cost": 1.20,
      "clicks": []                       // No click — empty array
    }
    // ... more impressions
  ]
}